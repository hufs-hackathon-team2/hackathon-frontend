{
  "expo": {
    "name": "헬플리",
    "slug": "healply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3ECFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3E629F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.seoyn95.healply"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "위클리 카드를 사진첩에 저장하기 위해 사용합니다.",
          "savePhotosPermission": "위클리 카드를 사진첩에 저장하기 위해 사용합니다.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "37a1a146-6aa4-4f91-ae11-aa8bd4b599d0"
      }
    }
  }
}
